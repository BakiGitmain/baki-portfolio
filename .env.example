# Browser REST base. The existing Next.js rewrite accepts /backend locally and in production.
NEXT_PUBLIC_API_URL=/backend

# Server-only REST base used by server-rendered code when needed.
BACKEND_API_URL=http://localhost:5000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PERFORMANCE_SITE_SLUG=baki-portfolio

# Socket.IO cannot use the /backend HTTP rewrite. Point this directly at the backend origin.
# Production: https://baki-portfolio-backend.vercel.app
NEXT_PUBLIC_CHAT_SOCKET_URL=http://localhost:5000
