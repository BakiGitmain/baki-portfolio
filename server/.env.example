PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://bakidigital.com

DATABASE_URL=
# Required in production for cross-instance Chat fan-out and distributed rate limits.
# REDIS_URL=redis://localhost:6379

JWT_SECRET=
JWT_COOKIE_NAME=baki_admin_token

ADMIN_SEED_NAME=
ADMIN_SEED_USERNAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CLOUDINARY_PROJECT_FOLDER=baki-portfolio/projects

# Private sales-representative identification assets
CLOUDINARY_APPLICATION_ID_FOLDER=baki-portfolio/private/hire-ids
CLOUDINARY_REPRESENTATIVE_AVATAR_FOLDER=baki-portfolio/representative-avatars

# Mistral / Baki AI
OPENAI_API_KEY=
OPENAI_MODEL=

REP_JWT_COOKIE_NAME=baki_rep_token

# Existing Resend delivery infrastructure (applications, onboarding, reports)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Baki Digital <noreply@bakidigital.com>

# Private inbox that receives website project inquiries
CONTACT_RECEIVER_EMAIL=

# Partner Chat scheduled hard-deletion endpoint
CHAT_RETENTION_SECRET=replace-with-at-least-32-random-characters

# Temporary safe Partner Chat stage timings (never logs tokens or secrets)
CHAT_PERF_DIAGNOSTICS=false
